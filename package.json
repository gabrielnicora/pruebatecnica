{
  "name": "pruebatecnica-mountebank-poc",
  "version": "1.0.0",
  "description": "POC de virtualización de servicios bancarios con mountebank",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "mb:start": "mb --configfile mountebank/imposters.json --allowInjection",
    "mb:stop": "mb stop",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "mountebank": "^2.9.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
