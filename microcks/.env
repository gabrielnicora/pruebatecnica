# =============================================================================
#  Configuración de la POC de Microcks
# =============================================================================
#
#  Para alternar entre modo CON y SIN autenticación, lo más simple es usar
#  el helper:   ./poc.sh up        (con Keycloak)
#               ./poc.sh up-noauth (sin Keycloak)
#
#  Si preferís docker compose a mano, estas son las variables que importan:
# =============================================================================

# ── Keycloak ON (default) ────────────────────────────────────────────────────
# Activa el contenedor de Keycloak (profile "auth") y le dice a Microcks que
# exija autenticación.
COMPOSE_PROFILES=auth
KEYCLOAK_ENABLED=true

# ── Credenciales del service account que usa el CLI (importer/contract-tester)
# Vienen del realm oficial de Microcks. NO cambiar salvo que edites el realm.
KC_CLIENT_ID=microcks-serviceaccount
KC_CLIENT_SECRET=ab54d329-e435-41ae-a900-ec6b3fe15c54

# =============================================================================
#  PARA CORRER SIN KEYCLOAK (modo sin credenciales que mantener):
#  comentá las dos líneas de arriba (COMPOSE_PROFILES y KEYCLOAK_ENABLED)
#  y descomentá estas:
# =============================================================================
# COMPOSE_PROFILES=
# KEYCLOAK_ENABLED=false
